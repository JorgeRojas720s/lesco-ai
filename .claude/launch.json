{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lesco-server",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.api.server:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8011", "--directory", "app/frontend"],
      "port": 8011
    }
  ]
}
